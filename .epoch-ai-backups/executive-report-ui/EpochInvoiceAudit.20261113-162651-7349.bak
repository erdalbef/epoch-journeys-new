"use client";

import { useState } from "react";

type AuditResponse = {
  verificationStatus?: string;
  fullyVerified?: boolean;
  analysis?: string;
  error?: string;
  documentsExamined?: Array<{
    id: string;
    fileName: string;
  }>;
  preliminary?: {
    financials?: {
      approvedAmount?: string;
      contractedAmount?: string | null;
      recordedVariance?: string | null;
    };
    currency?: string;
  };
};

export default function EpochInvoiceAudit({
  payableId,
}: {
  payableId: string;
}) {
  const [loading, setLoading] = useState(false);
  const [result, setResult] = useState<AuditResponse | null>(null);
  const [error, setError] = useState<string | null>(null);

  async function analyze() {
    if (loading) return;

    const confirmed = window.confirm(
      "Analyze this supplier invoice with Epoch AI? " +
      "The invoice PDF and payable audit information will " +
      "be sent to the configured OpenAI API for analysis. " +
      "No financial records will be changed."
    );

    if (!confirmed) return;

    setLoading(true);
    setResult(null);
    setError(null);

    try {
      const response = await fetch(
        "/api/admin/epoch-ai/finance/supplier-invoice-audit/analyze",
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ payableId }),
          cache: "no-store",
        }
      );

      const data = (await response.json()) as AuditResponse;

      if (!response.ok) {
        throw new Error(
          data.error || `Invoice analysis failed (${response.status}).`
        );
      }

      if (!data.analysis) {
        throw new Error("The AI service returned no analysis.");
      }

      setResult(data);
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Unable to complete invoice analysis."
      );
    } finally {
      setLoading(false);
    }
  }

  return (
    <section className="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <div className="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 className="text-lg font-bold text-[#001F3F]">
            Epoch AI - Supplier Invoice Audit
          </h2>
          <p className="mt-2 text-sm text-slate-500">
            Examine the supplier invoice and compare it with
            the recorded payable.
          </p>
        </div>

        <span className="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700">
          Read-only
        </span>
      </div>

      <button
        type="button"
        onClick={analyze}
        disabled={loading}
        className="mt-5 rounded-xl bg-[#001F3F] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#003366] disabled:cursor-not-allowed disabled:opacity-50"
      >
        {loading ? "Analyzing invoice..." : "Analyze Invoice with Epoch AI"}
      </button>

      {error && (
        <div role="alert" className="mt-4 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
          {error}
        </div>
      )}

      {result && (
        <div className="mt-5 space-y-4 border-t border-slate-200 pt-5">
          <div className="flex flex-wrap items-center gap-3">
            <span className="rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-800">
              Preliminary
            </span>
            <span className="text-xs text-slate-500">
              Not a payment approval
            </span>
          </div>

          {result.documentsExamined && (
            <div>
              <p className="text-xs font-semibold uppercase text-slate-500">
                Documents submitted for examination
              </p>
              {result.documentsExamined.map((doc) => (
                <p key={doc.id} className="mt-1 break-all text-sm text-slate-700">
                  {doc.fileName}
                </p>
              ))}
            </div>
          )}

          <div className="rounded-xl bg-slate-50 p-4">
            <h3 className="font-semibold text-slate-900">
              Financial Audit Report
            </h3>
            <div className="mt-3 whitespace-pre-wrap break-words text-sm leading-6 text-slate-700">
              {result.analysis}
            </div>
          </div>

          <p className="text-xs leading-5 text-slate-500">
            AI-generated findings require review against the
            original invoice and accepted supplier terms.
            No financial records were changed.
          </p>
        </div>
      )}
    </section>
  );
}
