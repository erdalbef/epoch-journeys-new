generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  password String

  agentCode String? @unique

  role               Role                @default(AGENT)
  approved           Boolean             @default(false)
  status             AgentStatus         @default(ACTIVE)
  partnerType        PartnerType         @default(TRAVEL_AGENCY)
  commissionRate     Float?
  payoutPerPax       Float?
  fullName           String?
  travelAgency       String?
  phone              String?
  website            String?
  membership         String?
  notes              String?
  signupIp           String?
  signupUserAgent    String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  agentLogoUrl       String?
  bookings           Booking[]
  customTourRequests CustomTourRequest[]

  paymentSubmissions         PaymentSubmission[] @relation("PaymentSubmissionUser")
  reviewedPaymentSubmissions PaymentSubmission[] @relation("PaymentSubmissionReviewer")
}

model Tour {
  id    String @id @default(cuid())
  title String

  tourCode String? @unique

  category          String
  subcategories     String[]
  tags              String[]
  destinations      String[]
  duration          Int
  shortDescription  String?
  overview          String?
  tourIntroduction  String?
  tourSignificance  String?
  destinationBriefs String?

  pricingType  PricingType   @default(FIXED_GROUP)
  basePrice    Float?
  pricingTiers PricingTier[]

  highlights        String[]
  inclusions        String[]
  exclusions        String[]
  accommodations    String[]
  overviewItinerary String?
  itinerary         String?
  mainImageUrl      String?
  mapImageUrl       String?
  brochureUrl       String?
  featured          Boolean           @default(false)
  isPublished       Boolean           @default(false)
  requiresQuote     Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  bookings          Booking[]
  departureDates    DepartureDate[]
  seasonalPrices    TourSeasonPrice[]
}

model DepartureDate {
  id                    String          @id @default(cuid())
  tourId                String
  date                  DateTime
  season                Season          @map("seasonEnum")
  seasonOld             String?         @map("season")
  price                 Float
  status                DepartureStatus @default(AVAILABLE)
  earlyDiscountPercent  Float?
  earlyDiscountDeadline DateTime?
  capacity              Int             @default(0)
  bookedSeats           Int             @default(0)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  bookings              Booking[]
  tour                  Tour            @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model Booking {
  id                 String  @id @default(cuid())
  bookingNumber      Int     @unique @default(autoincrement())
  bookingReference   String  @unique
  bookingDisplayCode String? @unique

  userId          String
  tourId          String
  departureDateId String

  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)

  numberOfGuests Int

  // Pricing
  totalPrice             Float
  grossAmount            Float
  commissionRateSnapshot Float?
  payoutPerPaxSnapshot   Float?
  commissionAmount       Float  @default(0)
  netAmount              Float
  currency               String @default("EUR")

  // Payment tracking
  amountPaid     Float    @default(0)
  amountDue      Float    @default(0)
  paymentDueDate DateTime?

  // Agent snapshot
  agentNameSnapshot   String?
  agentEmailSnapshot  String?
  agentPhoneSnapshot  String?
  agencyNameSnapshot  String?
  partnerTypeSnapshot PartnerType?
  membershipSnapshot  String?

  // Tour snapshot
  tourTitleSnapshot        String
  categorySnapshot         String
  subcategoriesSnapshot    String[]
  tagsSnapshot             String[]
  destinationsSnapshot     String[]
  durationSnapshot         Int
  shortDescriptionSnapshot String?
  overviewSnapshot         String?
  brochureUrlSnapshot      String?
  mainImageUrlSnapshot     String?
  mapImageUrlSnapshot      String?

  // Departure snapshot
  departureDateSnapshot         DateTime
  seasonSnapshot                Season  @map("seasonSnapshotEnum")
  seasonSnapshotOld             String? @map("seasonSnapshot")
  pricePerPersonSnapshot        Float
  earlyDiscountPercentSnapshot  Float?
  earlyDiscountDeadlineSnapshot DateTime?

  // Customer
  customerName  String?
  customerEmail String?
  customerPhone String?

  leadFirstName String?
  leadLastName  String?
  leadEmail     String?
  leadPhone     String?

  // Pax
  adults   Int @default(1)
  children Int @default(0)
  infants  Int @default(0)

  // Rooming
  singleRooms Int @default(0)
  doubleRooms Int @default(0)
  twinRooms   Int @default(0)
  tripleRooms Int @default(0)

  // Options
  landOnly     Boolean @default(true)
  needsFlights Boolean @default(false)

  // Notes
  notes           String?
  specialRequests String?
  internalNotes   String?

  // Meta
  bookingType         BookingType @default(FIT)
  depositDeadline     DateTime?
  estimatedPax        Int?
  finalPax            Int?
  groupLeaderName     String?
  groupName           String?
  roomingListDeadline DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departureDate      DepartureDate       @relation(fields: [departureDateId], references: [id])
  tour               Tour                @relation(fields: [tourId], references: [id])
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  passengers         Passenger[]
  payments           Payment[]
  paymentSubmissions PaymentSubmission[]

  @@index([userId])
  @@index([tourId])
  @@index([departureDateId])
  @@index([status])
  @@index([paymentStatus])
  @@index([bookingType])
  @@index([createdAt])
}

model CustomTourRequest {
  id                 String              @id @default(cuid())
  userId             String
  requestReference   String              @unique
  status             CustomRequestStatus @default(NEW)
  requestType        CustomRequestType   @default(TAILOR_MADE)
  title              String?
  destination        String?
  destinations       String[]
  startDate          DateTime?
  endDate            DateTime?
  durationDays       Int?
  estimatedPax       Int?
  adults             Int?
  children           Int?
  budgetPerPerson    Float?
  currency           String              @default("EUR")
  accommodationLevel String?
  roomPreference     String?
  needsFlights       Boolean             @default(false)
  landOnly           Boolean             @default(true)
  groupName          String?
  groupLeaderName    String?
  customerName       String?
  customerEmail      String?
  customerPhone      String?
  notes              String?
  internalNotes      String?
  adminReply         String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Passenger {
  id              String    @id @default(cuid())
  bookingId       String
  firstName       String
  lastName        String
  gender          String?
  dateOfBirth     DateTime?
  nationality     String?
  passportNumber  String?
  passportExpiry  DateTime?
  roomType        String?
  isLeadPassenger Boolean   @default(false)
  specialRequests String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  booking         Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model Payment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  amount   Float
  currency String @default("EUR")

  method PaymentMethod
  status PaymentRecordStatus @default(PENDING)

  reference  String?
  notes      String?
  paidAt     DateTime?
  receivedBy String?

  @@index([bookingId])
  @@index([status])
}

model PaymentSubmission {
  id           String                  @id @default(cuid())
  bookingId    String
  userId       String
  amount       Float
  currency     String                  @default("EUR")
  method       String
  note         String?
  proofUrl     String?
  status       PaymentSubmissionStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user       User    @relation("PaymentSubmissionUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation("PaymentSubmissionReviewer", fields: [reviewedById], references: [id])

  @@index([bookingId])
  @@index([userId])
  @@index([status])
}

model PricingTier {
  id String @id @default(cuid())

  tourId String
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  minPax Int
  maxPax Int

  roomType RoomType
  price    Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TourSeasonPrice {
  id        String   @id @default(cuid())
  tourId    String
  season    Season
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([tourId, season])
  @@index([tourId])
}

enum DepartureStatus {
  EARLY_BOOKING
  AVAILABLE
  SOLD_OUT
  CLOSED
}

enum Role {
  ADMIN
  AGENT
}

enum PartnerType {
  TOUR_OPERATOR
  TRAVEL_AGENCY
  TRAVEL_EXPERT
  GROUP_LEADER
}

enum AgentStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum BookingType {
  FIT
  GROUP
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ON_REQUEST
  CANCELLED
  WAITLIST
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum PaymentMethod {
  BANK_TRANSFER
  STRIPE
  PAYPAL
  CASH
  OTHER
}

enum PaymentRecordStatus {
  PENDING
  RECEIVED
  FAILED
  REFUNDED
}

enum PaymentSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CustomRequestStatus {
  NEW
  IN_REVIEW
  QUOTED
  CONFIRMED
  CANCELLED
}

enum CustomRequestType {
  TAILOR_MADE
  BESPOKE_GROUP
}

enum PricingType {
  FIXED_GROUP
  GROUP_BASED
  FIT_DYNAMIC
  FIT_FIXED
  FIT_TIERED
}

enum Season {
  LOW
  SHOULDER
  HIGH
  PEAK
}

enum RoomType {
  SINGLE
  DOUBLE_TWIN
  TRIPLE
}