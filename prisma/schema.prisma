// Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  password String

  role     Role    @default(AGENT)
  approved Boolean @default(false)

  /// Partner classification
  partnerType PartnerType @default(TRAVEL_AGENCY)

  /**
   * Commercial Rules
   * TOUR_OPERATOR / TRAVEL_AGENCY / TRAVEL_EXPERT:
   *    → commissionRate (e.g. 0.12 = 12%)
   *
   * GROUP_LEADER:
   *    → fixedPayoutPerPax (e.g. 150)
   */
  commissionRate    Float?
  fixedPayoutPerPax Float?

  /**
   * Partner Profile (admin-editable)
   */
  fullName     String?
  travelAgency String?  // Required for TOUR_OPERATOR & TRAVEL_AGENCY
  phone        String?
  website      String?  // Required for TOUR_OPERATOR & TRAVEL_AGENCY
  membership   String?  // ASTA / NTA / IATA / CLIA / None
  notes        String?  // Internal admin notes only

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  AGENT
}

enum PartnerType {
  TOUR_OPERATOR
  TRAVEL_AGENCY
  TRAVEL_EXPERT
  GROUP_LEADER
}