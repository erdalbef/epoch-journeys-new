generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  password String

  agentCode String? @unique

  role               Role                @default(AGENT)
  approved           Boolean             @default(false)
  status             AgentStatus         @default(ACTIVE)
  partnerType        PartnerType         @default(TRAVEL_AGENCY)
  commissionRate     Float?
  payoutPerPax       Float?
  fullName           String?
  travelAgency       String?
  phone              String?
  website            String?
  membership         String?
  notes              String?
  signupIp           String?
  signupUserAgent    String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  agentLogoUrl       String?
  bookings           Booking[]
  customTourRequests CustomTourRequest[]
}

model Tour {
  id    String @id @default(cuid())
  title String

  tourCode String? @unique

  category          String
  subcategories     String[]
  tags              String[]
  destinations      String[]
  duration          Int
  shortDescription  String?
  overview          String?
  tourIntroduction  String?
  tourSignificance  String?
  destinationBriefs String?

  pricingType       PricingType @default(FIXED_GROUP)
  basePrice         Float?
  pricingTiers      PricingTier[]

  highlights        String[]
  inclusions        String[]
  exclusions        String[]
  accommodations    String[]
  overviewItinerary String?
  itinerary         String?
  mainImageUrl      String?
  mapImageUrl       String?
  brochureUrl       String?
  featured          Boolean         @default(false)
  isPublished       Boolean         @default(false)
  requiresQuote     Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  bookings          Booking[]
  departureDates    DepartureDate[]
}

model DepartureDate {
  id                    String          @id @default(cuid())
  tourId                String
  date                  DateTime
  season                String
  price                 Float
  status                DepartureStatus @default(AVAILABLE)
  earlyDiscountPercent  Float?
  earlyDiscountDeadline DateTime?
  capacity              Int             @default(0)
  bookedSeats           Int             @default(0)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  bookings              Booking[]
  tour                  Tour            @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model Booking {
  id                 String  @id @default(cuid())
  bookingNumber      Int     @unique @default(autoincrement())
  bookingReference   String  @unique
  bookingDisplayCode String? @unique

  userId                        String
  tourId                        String
  departureDateId               String
  status                        BookingStatus @default(PENDING)
  paymentStatus                 PaymentStatus @default(UNPAID)
  numberOfGuests                Int
  totalPrice                    Float
  grossAmount                   Float
  commissionRateSnapshot        Float?
  payoutPerPaxSnapshot          Float?
  commissionAmount              Float         @default(0)
  netAmount                     Float
  currency                      String        @default("EUR")
  agentNameSnapshot             String?
  agentEmailSnapshot            String?
  agentPhoneSnapshot            String?
  agencyNameSnapshot            String?
  partnerTypeSnapshot           PartnerType?
  membershipSnapshot            String?
  tourTitleSnapshot             String
  categorySnapshot              String
  subcategoriesSnapshot         String[]
  tagsSnapshot                  String[]
  destinationsSnapshot          String[]
  durationSnapshot              Int
  shortDescriptionSnapshot      String?
  overviewSnapshot              String?
  brochureUrlSnapshot           String?
  mainImageUrlSnapshot          String?
  mapImageUrlSnapshot           String?
  departureDateSnapshot         DateTime
  seasonSnapshot                String
  pricePerPersonSnapshot        Float
  earlyDiscountPercentSnapshot  Float?
  earlyDiscountDeadlineSnapshot DateTime?
  customerName                  String?
  customerEmail                 String?
  customerPhone                 String?
  leadFirstName                 String?
  leadLastName                  String?
  leadEmail                     String?
  leadPhone                     String?
  adults                        Int           @default(1)
  children                      Int           @default(0)
  infants                       Int           @default(0)
  singleRooms                   Int           @default(0)
  doubleRooms                   Int           @default(0)
  twinRooms                     Int           @default(0)
  landOnly                      Boolean       @default(true)
  needsFlights                  Boolean       @default(false)
  notes                         String?
  specialRequests               String?
  internalNotes                 String?
  createdAt                     DateTime      @default(now())
  updatedAt                     DateTime      @updatedAt
  bookingType                   BookingType   @default(FIT)
  depositDeadline               DateTime?
  estimatedPax                  Int?
  finalPax                      Int?
  groupLeaderName               String?
  groupName                     String?
  roomingListDeadline           DateTime?
  departureDate                 DepartureDate @relation(fields: [departureDateId], references: [id])
  tour                          Tour          @relation(fields: [tourId], references: [id])
  user                          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  passengers                    Passenger[]

  @@index([userId])
  @@index([tourId])
  @@index([departureDateId])
  @@index([status])
  @@index([paymentStatus])
  @@index([bookingType])
  @@index([createdAt])
}

model CustomTourRequest {
  id                 String              @id @default(cuid())
  userId             String
  requestReference   String              @unique
  status             CustomRequestStatus @default(NEW)
  requestType        CustomRequestType   @default(TAILOR_MADE)
  title              String?
  destination        String?
  destinations       String[]
  startDate          DateTime?
  endDate            DateTime?
  durationDays       Int?
  estimatedPax       Int?
  adults             Int?
  children           Int?
  budgetPerPerson    Float?
  currency           String              @default("EUR")
  accommodationLevel String?
  roomPreference     String?
  needsFlights       Boolean             @default(false)
  landOnly           Boolean             @default(true)
  groupName          String?
  groupLeaderName    String?
  customerName       String?
  customerEmail      String?
  customerPhone      String?
  notes              String?
  internalNotes      String?
  adminReply         String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Passenger {
  id              String    @id @default(cuid())
  bookingId       String
  firstName       String
  lastName        String
  gender          String?
  dateOfBirth     DateTime?
  nationality     String?
  passportNumber  String?
  passportExpiry  DateTime?
  roomType        String?
  isLeadPassenger Boolean   @default(false)
  specialRequests String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  booking         Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model PricingTier {
  id      String @id @default(cuid())
  tourId  String
  minPax  Int
  maxPax  Int
  price   Float

  tour    Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

enum DepartureStatus {
  EARLY_BOOKING
  AVAILABLE
  SOLD_OUT
  CLOSED
}

enum Role {
  ADMIN
  AGENT
}

enum PartnerType {
  TOUR_OPERATOR
  TRAVEL_AGENCY
  TRAVEL_EXPERT
  GROUP_LEADER
}

enum AgentStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum BookingType {
  FIT
  GROUP
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ON_REQUEST
  CANCELLED
  WAITLIST
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum CustomRequestStatus {
  NEW
  IN_REVIEW
  QUOTED
  CONFIRMED
  CANCELLED
}

enum CustomRequestType {
  TAILOR_MADE
  BESPOKE_GROUP
}

enum PricingType {
  FIXED_GROUP
  GROUP_BASED
  FIT_DYNAMIC
  FIT_FIXED
  FIT_TIERED
}