generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  password String

  role     Role        @default(AGENT)
  approved Boolean     @default(false)
  status   AgentStatus @default(ACTIVE)

  partnerType PartnerType @default(TRAVEL_AGENCY)

  commissionRate Float?
  payoutPerPax   Float?

  fullName     String?
  travelAgency String?
  phone        String?
  website      String?
  membership   String?
  notes        String?

  signupIp        String?
  signupUserAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tour {
  id                String   @id @default(cuid())
  title             String
  slug              String   @unique

  category          String
  subcategories     String[]
  tags              String[]

  destinations      String[]
  duration          Int

  shortDescription  String?
  overview          String?
  tourIntroduction  String?
  tourSignificance  String?
  destinationBriefs String?

  highlights        String[]
  inclusions        String[]
  exclusions        String[]
  accommodations    String[]
  overviewItinerary String?
  itinerary         String?

  mainImageUrl      String?
  mapImageUrl       String?
  brochureUrl       String?

  featured          Boolean  @default(false)
  isPublished       Boolean  @default(false)
  requiresQuote     Boolean  @default(false)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum Role {
  ADMIN
  AGENT
}

enum PartnerType {
  TOUR_OPERATOR
  TRAVEL_AGENCY
  TRAVEL_EXPERT
  GROUP_LEADER
}

enum AgentStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}