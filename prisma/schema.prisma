generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String      @id @default(cuid())
  email           String      @unique
  password        String
  role            Role        @default(AGENT)
  approved        Boolean     @default(false)
  status          AgentStatus @default(ACTIVE)
  partnerType     PartnerType @default(TRAVEL_AGENCY)
  commissionRate  Float?
  payoutPerPax    Float?
  fullName        String?
  travelAgency    String?
  phone           String?
  website         String?
  membership      String?
  notes           String?
  signupIp        String?
  signupUserAgent String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  agentLogoUrl    String?
  agentCode       String?     @unique

  partnerCompanyId String?
  partnerCompany   PartnerCompany? @relation(fields: [partnerCompanyId], references: [id], onDelete: SetNull)

  bookings           Booking[]
  customTourRequests CustomTourRequest[]
  customRequestNotes CustomRequestNote[]
  supportMessages    SupportMessage[]

  partnerPayouts             PartnerPayout[]       @relation("AgentPayouts")
  processedPartnerPayouts    PartnerPayout[]       @relation("ProcessedPartnerPayouts")
  reviewedPaymentSubmissions PaymentSubmission[]   @relation("PaymentSubmissionReviewer")
  paymentSubmissions         PaymentSubmission[]   @relation("PaymentSubmissionUser")
  agentTourCommissions       AgentTourCommission[]

  expensesCreated Expense[] @relation("ExpenseCreatedBy")

  quoteActivities    QuoteActivity[]
  quotesFinalized    Quote[]              @relation("QuoteFinalizedBy")
  quotesSent         Quote[]              @relation("QuoteSentBy")
  quoteTemplates     QuoteTemplate[]
  AgentCommunication AgentCommunication[]

  supplierPayablesCreated  SupplierPayable[]        @relation("SupplierPayableCreatedBy")
  supplierPayablesApproved SupplierPayable[]        @relation("SupplierPayableApprovedBy")
  supplierPaymentsRecorded SupplierPayablePayment[] @relation("SupplierPaymentRecordedBy")

  bankTransactionsCreated BankTransaction[] @relation("BankTransactionCreatedBy")

  refundsCreated Refund[] @relation("RefundCreatedBy")

  @@index([role])
  @@index([approved])
  @@index([status])
  @@index([partnerType])
  @@index([partnerCompanyId])
}

model Tour {
  id                 String       @id @default(cuid())
  title              String
  category           String
  subcategories      String[]
  tags               String[]
  destinations       String[]
  duration           Int
  shortDescription   String?
  overview           String?
  tourIntroduction   String?
  tourSignificance   String?
  destinationBriefs  String?
  highlights         String[]
  inclusions         String[]
  exclusions         String[]
  accommodations     String[]
  overviewItinerary  String?
  itinerary          String?
  mainImageUrl       String?
  imageUrl2          String?
  imageUrl3          String?
  imageUrl4          String?
  mapImageUrl        String?
  brochureUrl        String?
  featured           Boolean      @default(false)
  isPublished        Boolean      @default(false)
  requiresQuote      Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  tourCode           String?      @unique
  pricingType        PricingType  @default(FIXED_GROUP)
  privatePricing     Json?
  whyWeOfferThisTour String?
  tourControl        TourControl?

  bookings             Booking[]
  departureDates       DepartureDate[]
  seasonalPrices       TourSeasonalPrice[]
  pricingTiers         PricingTier[]
  agentTourCommissions AgentTourCommission[]
  quotes               Quote[]
  partnerTourAliases   PartnerTourAlias[]

  expenses         Expense[]
  financeEntries   FinanceEntry[]
  massArrangements MassArrangement[]
  supplierPayables SupplierPayable[]

  bankTransactions BankTransaction[]

  @@index([category])
  @@index([featured])
  @@index([isPublished])
  @@index([pricingType])
}

model TourSeasonalPrice {
  id        String   @id @default(cuid())
  tourId    String
  season    Season
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([tourId, season], name: "tourId_season")
  @@index([tourId])
  @@index([season])
}

model DepartureDate {
  id     String   @id @default(cuid())
  tourId String
  date   DateTime

  price            Float
  priceDouble      Float
  singleSupplement Float?
  tripleReduction  Float?

  status                DepartureStatus @default(AVAILABLE)
  earlyDiscountPercent  Float?
  earlyDiscountDeadline DateTime?
  capacity              Int             @default(0)
  bookedSeats           Int             @default(0)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  season                Season          @map("seasonEnum")

  tour     Tour      @relation(fields: [tourId], references: [id], onDelete: Cascade)
  bookings Booking[]
  quotes   Quote[]

  expenses         Expense[]
  massArrangements MassArrangement[]
  supplierPayables SupplierPayable[]

  bankTransactions BankTransaction[]

  @@index([tourId])
  @@index([date])
  @@index([status])
  @@index([season])
}

model TourControl {
  id     String @id @default(cuid())
  tourId String @unique
  tour   Tour   @relation(fields: [tourId], references: [id])

  hotelStatus      Boolean @default(false)
  busStatus        Boolean @default(false)
  guideStatus      Boolean @default(false)
  restaurantStatus Boolean @default(false)
  massStatus       Boolean @default(false)
  ticketStatus     Boolean @default(false)
  supplierPayments Boolean @default(false)
  roomingList      Boolean @default(false)
  flightList       Boolean @default(false)
  travelDocuments  Boolean @default(false)

  finalNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booking {
  id               String @id @default(cuid())
  bookingReference String @unique
  userId           String
  tourId           String
  departureDateId  String

  partnerCompanyId   String?
  partnerTourAliasId String?
  partnerPackageName String?

  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  bookingType   BookingType   @default(FIT)

  numberOfGuests         Int
  totalPrice             Float
  grossAmount            Float
  commissionRateSnapshot Float?
  payoutPerPaxSnapshot   Float?
  commissionAmount       Float  @default(0)
  netAmount              Float
  currency               String @default("EUR")

  agentNameSnapshot   String?
  agentEmailSnapshot  String?
  agentPhoneSnapshot  String?
  agencyNameSnapshot  String?
  partnerTypeSnapshot PartnerType?
  membershipSnapshot  String?

  tourTitleSnapshot             String
  categorySnapshot              String
  subcategoriesSnapshot         String[]
  tagsSnapshot                  String[]
  destinationsSnapshot          String[]
  durationSnapshot              Int
  shortDescriptionSnapshot      String?
  overviewSnapshot              String?
  brochureUrlSnapshot           String?
  mainImageUrlSnapshot          String?
  mapImageUrlSnapshot           String?
  departureDateSnapshot         DateTime
  seasonSnapshot                Season    @map("seasonSnapshotEnum")
  pricePerPersonSnapshot        Float
  earlyDiscountPercentSnapshot  Float?
  earlyDiscountDeadlineSnapshot DateTime?

  customerName  String?
  customerEmail String?
  customerPhone String?

  leadFirstName String?
  leadLastName  String?
  leadEmail     String?
  leadPhone     String?

  adults   Int @default(1)
  children Int @default(0)
  infants  Int @default(0)

  singleRooms Int @default(0)
  doubleRooms Int @default(0)
  twinRooms   Int @default(0)
  tripleRooms Int @default(0)

  landOnly     Boolean @default(true)
  needsFlights Boolean @default(false)

  notes           String?
  specialRequests String?
  internalNotes   String?

  depositDeadline DateTime?
  paymentDueDate  DateTime?
  amountDue       Float     @default(0)
  amountPaid      Float     @default(0)

  estimatedPax        Int?
  finalPax            Int?
  groupLeaderName     String?
  groupName           String?
  roomingListDeadline DateTime?

  bookingDisplayCode String? @unique
  bookingNumber      Int     @unique @default(autoincrement())

  payoutId String?
  quoteId  String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tour             Tour              @relation(fields: [tourId], references: [id])
  departureDate    DepartureDate     @relation(fields: [departureDateId], references: [id])
  payout           PartnerPayout?    @relation(fields: [payoutId], references: [id])
  quote            Quote?            @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  partnerCompany   PartnerCompany?   @relation(fields: [partnerCompanyId], references: [id], onDelete: SetNull)
  partnerTourAlias PartnerTourAlias? @relation(fields: [partnerTourAliasId], references: [id], onDelete: SetNull)

  passengers         Passenger[]
  roomAssignments    RoomAssignment[]
  payments           Payment[]
  paymentSubmissions PaymentSubmission[]
  supportMessages    SupportMessage[]

  expenses       Expense[]
  financeEntries FinanceEntry[]

  paymentSchedules BookingPaymentSchedule[]

  operationControl BookingOperationControl?
  massArrangements MassArrangement[]
  supplierPayables SupplierPayable[]

  bankTransactions BankTransaction[]

  refunds Refund[]

  @@index([userId])
  @@index([tourId])
  @@index([departureDateId])
  @@index([payoutId])
  @@index([status])
  @@index([paymentStatus])
  @@index([bookingType])
  @@index([createdAt])
  @@index([groupName])
  @@index([partnerCompanyId])
  @@index([partnerTourAliasId])
  @@index([partnerPackageName])
}

model BookingOperationControl {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id])

  hotelStatus      Boolean @default(false)
  busStatus        Boolean @default(false)
  guideStatus      Boolean @default(false)
  restaurantStatus Boolean @default(false)
  massStatus       Boolean @default(false)
  ticketStatus     Boolean @default(false)
  supplierPayments Boolean @default(false)
  roomingList      Boolean @default(false)
  flightList       Boolean @default(false)
  travelDocuments  Boolean @default(false)
  hotelItems       Json?
  transportItems   Json?
  guideItems       Json?
  restaurantItems  Json?
  massItems        Json?
  ticketItems      Json?
  paymentItems     Json?
  documentItems    Json?
  emergencyItems   Json?

  status OperationStatus @default(PENDING)

  finalNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomTourRequest {
  id               String @id @default(cuid())
  userId           String
  requestReference String @unique

  status      CustomRequestStatus @default(NEW)
  requestType CustomRequestType   @default(TAILOR_MADE)
  bookingType BookingType         @default(FIT)

  title       String?
  requestName String?

  destination  String?
  destinations String[]
  startDate    DateTime?
  endDate      DateTime?
  durationDays Int?

  estimatedPax Int?
  adults       Int? @default(1)
  children     Int? @default(0)
  infants      Int? @default(0)

  singleRooms Int? @default(0)
  doubleRooms Int? @default(0)
  twinRooms   Int? @default(0)
  tripleRooms Int? @default(0)

  budgetPerPerson Float?
  totalBudget     Float?
  currency        String @default("EUR")

  accommodationLevel String?
  roomPreference     String?
  needsFlights       Boolean @default(false)
  landOnly           Boolean @default(true)

  companyName     String?
  groupName       String?
  groupLeaderName String?

  customerName  String?
  customerEmail String?
  customerPhone String?

  leadFirstName String?
  leadLastName  String?
  leadEmail     String?
  leadPhone     String?

  specialRequests String?
  notes           String?
  internalNotes   String?

  adminReply String?

  selectedQuoteId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestNotes  CustomRequestNote[]
  quotes        Quote[]             @relation("RequestQuotes")
  selectedQuote Quote?              @relation("SelectedQuote", fields: [selectedQuoteId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([requestType])
  @@index([bookingType])
  @@index([createdAt])
  @@index([customerEmail])
  @@index([groupName])
  @@index([selectedQuoteId])
}

model Quote {
  id              String  @id @default(cuid())
  requestId       String?
  tourId          String?
  departureDateId String?
  templateId      String?

  partnerCompanyId   String?
  partnerTourAliasId String?
  partnerPackageName String?

  quoteNumber    Int     @unique @default(autoincrement())
  quoteReference String? @unique
  version        Int     @default(1)

  purpose  QuotePurpose @default(CUSTOM_REQUEST)
  status   QuoteStatus  @default(DRAFT)
  currency String       @default("EUR")

  title         String?
  clientMessage String?
  internalNotes String?
  termsAndNotes String?
  validityNotes String?

  recipientName  String?
  recipientEmail String?
  recipientType  PartnerType?

  agentName   String?
  clientName  String?
  destination String?
  travelDates String?
  validUntil  DateTime?
  groupSize   Int?

  subtotal      Float @default(0)
  discountTotal Float @default(0)
  taxTotal      Float @default(0)
  totalAmount   Float @default(0)

  quoteBuilderPayload Json?
  quoteBuilderSummary Json?
  calculationVersion  String?

  pdfUrl         String?
  pdfGeneratedAt DateTime?

  clientPdfUrl         String?
  clientPdfGeneratedAt DateTime?

  agentClientPdfUrl         String?
  agentClientPdfGeneratedAt DateTime?

  clientSinglePrice     Float?
  clientDoubleTwinPrice Float?
  clientTriplePrice     Float?

  clientIncludes      String?
  clientExcludes      String?
  paymentPolicy       String?
  cancellationPolicy  String?
  clientOfferNotes    String?
  clientDocumentTitle String?

  finalizedAt   DateTime?
  finalizedById String?

  sentAt   DateTime?
  sentById String?

  viewedAt   DateTime?
  approvedAt DateTime?
  rejectedAt DateTime?

  convertedAt DateTime?
  expiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request          CustomTourRequest?  @relation("RequestQuotes", fields: [requestId], references: [id], onDelete: SetNull)
  selectedFor      CustomTourRequest[] @relation("SelectedQuote")
  tour             Tour?               @relation(fields: [tourId], references: [id], onDelete: SetNull)
  departureDate    DepartureDate?      @relation(fields: [departureDateId], references: [id], onDelete: SetNull)
  template         QuoteTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  finalizedBy      User?               @relation("QuoteFinalizedBy", fields: [finalizedById], references: [id], onDelete: SetNull)
  sentBy           User?               @relation("QuoteSentBy", fields: [sentById], references: [id], onDelete: SetNull)
  partnerCompany   PartnerCompany?     @relation(fields: [partnerCompanyId], references: [id], onDelete: SetNull)
  partnerTourAlias PartnerTourAlias?   @relation(fields: [partnerTourAliasId], references: [id], onDelete: SetNull)

  items      QuoteItem[]
  activities QuoteActivity[]
  booking    Booking?

  viewCount        Int @default(0)
  pdfDownloadCount Int @default(0)
  emailOpenCount   Int @default(0)

  @@index([requestId])
  @@index([tourId])
  @@index([departureDateId])
  @@index([templateId])
  @@index([status])
  @@index([purpose])
  @@index([createdAt])
  @@index([expiresAt])
  @@index([recipientEmail])
  @@index([calculationVersion])
  @@index([agentName])
  @@index([clientName])
  @@index([destination])
  @@index([validUntil])
  @@index([partnerCompanyId])
  @@index([partnerTourAliasId])
  @@index([partnerPackageName])
}

model QuoteItem {
  id      String @id @default(cuid())
  quoteId String

  itemType    QuoteItemType @default(SERVICE)
  title       String
  description String?

  quantity       Float  @default(1)
  unitPrice      Float
  discountAmount Float  @default(0)
  taxRate        Float?
  taxAmount      Float  @default(0)
  total          Float

  currency  String  @default("EUR")
  optional  Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  meta Json?

  @@index([quoteId])
  @@index([itemType])
  @@index([sortOrder])
  @@index([optional])
}

model QuoteActivity {
  id      String  @id @default(cuid())
  quoteId String
  actorId String?

  action     QuoteActivityAction
  fromStatus QuoteStatus?
  toStatus   QuoteStatus?
  message    String?
  meta       Json?

  createdAt DateTime @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model CustomRequestNote {
  id        String   @id @default(cuid())
  requestId String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  request CustomTourRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User              @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([authorId])
}

model Passenger {
  id               String  @id @default(cuid())
  bookingId        String
  roomAssignmentId String?

  firstName  String
  lastName   String
  middleName String?
  title      String?

  gender      String?
  dateOfBirth DateTime?
  nationality String?

  email String?
  phone String?

  passportNumber    String?
  passportExpiry    DateTime?
  passportIssueDate DateTime?
  passportCountry   String?

  roomType        RoomType?
  isLeadPassenger Boolean   @default(false)

  specialRequests       String?
  emergencyContactName  String?
  emergencyContactPhone String?
  notes                 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking        Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomAssignment RoomAssignment? @relation(fields: [roomAssignmentId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([roomAssignmentId])
  @@index([isLeadPassenger])
}

model RoomAssignment {
  id        String               @id @default(cuid())
  bookingId String
  roomCode  String?
  roomType  RoomType
  occupancy Int                  @default(1)
  status    RoomAssignmentStatus @default(DRAFT)
  notes     String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  booking    Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  passengers Passenger[]

  @@index([bookingId])
  @@index([roomType])
  @@index([status])
}

model Payment {
  id                   String              @id @default(cuid())
  bookingId            String
  amount               Float
  currency             String              @default("EUR")
  method               PaymentMethod
  status               PaymentRecordStatus @default(PENDING)
  reference            String?
  notes                String?
  paidAt               DateTime?
  receivedBy           String?
  allocationLockedAt   DateTime?
  allocationLockReason String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  booking     Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  allocations PaymentAllocation[]

  bankTransactions BankTransaction[]

  refunds Refund[]

  @@index([bookingId])
  @@index([status])
  @@index([paidAt])
  @@index([allocationLockedAt])
}

model PaymentAllocation {
  id                String @id @default(cuid())
  paymentId         String
  paymentScheduleId String

  amount      Float
  allocatedAt DateTime @default(now())
  notes       String?

  payment         Payment                @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentSchedule BookingPaymentSchedule @relation(fields: [paymentScheduleId], references: [id], onDelete: Cascade)

  @@unique([paymentId, paymentScheduleId])
  @@index([paymentId])
  @@index([paymentScheduleId])
}

model PaymentSubmission {
  id           String                  @id @default(cuid())
  bookingId    String
  userId       String
  amount       Float
  currency     String                  @default("EUR")
  method       String
  note         String?
  proofUrl     String?
  status       PaymentSubmissionStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation("PaymentSubmissionReviewer", fields: [reviewedById], references: [id])
  user       User    @relation("PaymentSubmissionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([userId])
  @@index([status])
}

model PartnerPayout {
  id            String  @id @default(cuid())
  agentId       String
  processedById String?

  totalAmount Float
  currency    String       @default("EUR")
  status      PayoutStatus @default(PENDING)

  notes            String?
  paymentMethod    String?
  paymentReference String?

  periodStart DateTime?
  periodEnd   DateTime?

  approvedAt DateTime?
  paidAt     DateTime?
  lockedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent       User      @relation("AgentPayouts", fields: [agentId], references: [id], onDelete: Cascade)
  processedBy User?     @relation("ProcessedPartnerPayouts", fields: [processedById], references: [id], onDelete: SetNull)
  bookings    Booking[]

  @@index([agentId])
  @@index([processedById])
  @@index([status])
  @@index([createdAt])
  @@index([paidAt])
}

model AgentTourCommission {
  id             String   @id @default(cuid())
  agentId        String
  tourId         String
  commissionRate Float?
  payoutPerPax   Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  agent User @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tour  Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([agentId, tourId])
  @@index([agentId])
  @@index([tourId])
}

model PricingTier {
  id             String    @id @default(cuid())
  tourId         String
  label          String?
  minPax         Int?
  maxPax         Int?
  roomType       RoomType?
  pricePerPerson Float
  currency       String    @default("EUR")
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId])
  @@index([roomType])
  @@index([isActive])
}

model SupportMessage {
  id             String   @id @default(cuid())
  userId         String
  bookingId      String?
  subject        String
  message        String
  requestType    String?
  attachmentPath String?
  attachmentName String?
  status         String   @default("OPEN")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([bookingId])
  @@index([status])
  @@index([createdAt])
}

model Expense {
  id          String  @id @default(cuid())
  title       String
  description String?

  amount   Float
  currency String @default("EUR")

  // Existing broad category remains for backward compatibility.
  category ExpenseCategory

  // New ERP-level classification.
  costType    ExpenseCostType    @default(OVERHEAD)
  expenseItem ExpenseItem?
  costCenter  ExpenseCostCenter?

  approvalStatus ExpenseApprovalStatus @default(DRAFT)
  paymentStatus  ExpensePaymentStatus  @default(PENDING)

  vendorName String?

  // Optional CRM supplier connection.
  supplierId String?

  // Optional bank/cash account used when the expense is actually paid.
  bankAccountId String?

  paymentMethod    PaymentMethod?
  paymentReference String?

  supplierInvoiceNumber String?
  invoiceDate           DateTime?
  dueDate               DateTime?

  expenseDate DateTime
  paidAt      DateTime?

  receiptUrl  String?
  documentUrl String?
  notes       String?

  recurring    Boolean @default(false)
  reimbursable Boolean @default(false)

  bookingId       String?
  tourId          String?
  departureDateId String?
  createdById     String?

  booking       Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  tour          Tour?          @relation(fields: [tourId], references: [id], onDelete: SetNull)
  departureDate DepartureDate? @relation(fields: [departureDateId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  supplier    Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  direction  FinanceDirection  @default(EXPENSE)
  sourceType FinanceSourceType @default(INTERNAL)

  taxType     FinanceTaxType @default(NONE)
  taxRate     Float?
  taxAmount   Float?         @default(0)
  grossAmount Float?
  netAmount   Float?

  originalAmount     Float  @default(0)
