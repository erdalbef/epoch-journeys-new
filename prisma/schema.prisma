generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id                         String                   @id @default(cuid())
  email                      String                   @unique
  password                   String
  role                       Role                     @default(AGENT)
  approved                   Boolean                  @default(false)
  status                     AgentStatus              @default(ACTIVE)
  partnerType                PartnerType              @default(TRAVEL_AGENCY)
  commissionRate             Float?
  payoutPerPax               Float?
  fullName                   String?
  travelAgency               String?
  phone                      String?
  website                    String?
  membership                 String?
  notes                      String?
  signupIp                   String?
  signupUserAgent            String?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  agentLogoUrl               String?
  agentCode                  String?                  @unique
  partnerCompanyId           String?
  billingAddress             String?
  billingCity                String?
  billingCompanyName         String?
  billingContactName         String?
  billingCountry             String?
  billingEmail               String?
  billingEmailSecondary      String?
  billingPostalCode          String?
  billingTaxNumber           String?
  billingVatNumber           String?
  billingCompanyRegNo        String?
  billingPhone               String?
  billingState               String?
  agentQuotes                Quote[]                  @relation("QuoteAgent")
  AgentCommunication         AgentCommunication[]
  agentTourCommissions       AgentTourCommission[]
  bankReconciliations        BankReconciliation[]
  bankStatements             BankStatement[]
  bankTransactions           BankTransaction[]
  bookings                   Booking[]
  cashTransactionsCreated    CashTransaction[]
  customRequestNotes         CustomRequestNote[]
  customTourRequests         CustomTourRequest[]
  expensesCreated            Expense[]                @relation("ExpenseCreatedBy")
  financeDocuments           FinanceDocument[]
  partnerPayouts             PartnerPayout[]          @relation("AgentPayouts")
  processedPartnerPayouts    PartnerPayout[]          @relation("ProcessedPartnerPayouts")
  reviewedPaymentSubmissions PaymentSubmission[]      @relation("PaymentSubmissionReviewer")
  paymentSubmissions         PaymentSubmission[]      @relation("PaymentSubmissionUser")
  acceptedQuotes             Quote[]                  @relation("QuoteAcceptedBy")
  quotesFinalized            Quote[]                  @relation("QuoteFinalizedBy")
  quotesSent                 Quote[]                  @relation("QuoteSentBy")
  quoteActivities            QuoteActivity[]
  quoteTemplates             QuoteTemplate[]
  refunds                    Refund[]
  resourcesUploaded          Resource[]               @relation("ResourceUploadedBy")
  salesDocumentsCreated      SalesDocument[]          @relation("SalesDocument_createdByIdToUser")
  salesDocumentsIssued       SalesDocument[]          @relation("SalesDocument_issuedByIdToUser")
  salesDocumentsSent         SalesDocument[]          @relation("SalesDocument_sentByIdToUser")
  supplierPayablesApproved   SupplierPayable[]        @relation("SupplierPayable_approvedByIdToUser")
  supplierPayablesCreated    SupplierPayable[]        @relation("SupplierPayable_createdByIdToUser")
  supplierPayablePayments    SupplierPayablePayment[]
  supportMessages            SupportMessage[]
  partnerCompany             PartnerCompany?          @relation(fields: [partnerCompanyId], references: [id])

  @@index([role])
  @@index([approved])
  @@index([status])
  @@index([partnerType])
  @@index([partnerCompanyId])
}

model Tour {
  id                       String                    @id @default(cuid())
  title                    String
  category                 String
  subcategories            String[]
  tags                     String[]
  destinations             String[]
  duration                 Int
  shortDescription         String?
  overview                 String?
  tourIntroduction         String?
  tourSignificance         String?
  destinationBriefs        String?
  highlights               String[]
  inclusions               String[]
  exclusions               String[]
  accommodations           String[]
  overviewItinerary        String?
  itinerary                String?
  mainImageUrl             String?
  mapImageUrl              String?
  brochureUrl              String?
  featured                 Boolean                   @default(false)
  isPublished              Boolean                   @default(false)
  requiresQuote            Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  tourCode                 String?                   @unique
  pricingType              PricingType               @default(GROUP_BASED)
  privatePricing           Json?
  whyWeOfferThisTour       String?
  imageUrl2                String?
  imageUrl3                String?
  imageUrl4                String?
  agentSellingPoints       String[]
  arrivalCity              String?
  currency                 String                    @default("EUR")
  departureCity            String?
  hotelStandard            String?
  idealFor                 String[]
  massIncluded             Boolean                   @default(true)
  mealPlan                 String?
  pace                     String?
  referenceGroupSize       Int?
  singleSupplementFrom     Float?
  startingPrice            Float?
  startingPriceBasis       String                    @default("DOUBLE_TWIN")
  subtitle                 String?
  transportationSummary    String?
  walkingLevel             String?
  agentTourCommissions     AgentTourCommission[]
  bankTransactions         BankTransaction[]
  bookings                 Booking[]
  cashTransactions         CashTransaction[]
  customTourRequests       CustomTourRequest[]
  departureDates           DepartureDate[]
  expenses                 Expense[]
  financeDocuments         FinanceDocument[]
  financeEntries           FinanceEntry[]
  massArrangements         MassArrangement[]
  partnerTourAliases       PartnerTourAlias[]
  payments                  Payment[]
  pricingTiers             PricingTier[]
  privateGroupPricingPlans PrivateGroupPricingPlan[]
  quotes                   Quote[]
  resources                Resource[]
  supplierPayables         SupplierPayable[]
  tourControl              TourControl?
  seasonalPrices           TourSeasonalPrice[]

  @@index([category])
  @@index([featured])
  @@index([isPublished])
  @@index([pricingType])
}

model TourSeasonalPrice {
  id               String    @id @default(cuid())
  tourId           String
  season           Season
  price            Float
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  currency         String    @default("EUR")
  minPax           Int?
  notes            String?
  singleSupplement Float?
  tripleReduction  Float?
  validFrom        DateTime?
  validTo          DateTime?
  tour             Tour      @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId])
  @@index([season])
  @@index([tourId, validFrom, validTo])
}

model PrivateGroupPricingPlan {
  id                String               @id @default(cuid())
  tourId            String
  year              Int
  currency          String               @default("EUR")
  title             String?
  description       String?
  isActive          Boolean              @default(true)
  minPayingPax      Int?
  maxPayingPax      Int?
  focEnabled        Boolean              @default(true)
  focPayingPaxRatio Int                  @default(10)
  focNotes          String?
  packageIncludes   String[]
  packageExcludes   String[]
  pricingNotes      String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  tour              Tour                 @relation(fields: [tourId], references: [id], onDelete: Cascade)
  seasons           PrivateGroupSeason[]

  @@unique([tourId, year])
  @@index([tourId])
  @@index([year])
  @@index([isActive])
}

model PrivateGroupSeason {
  id               String                  @id @default(cuid())
  pricingPlanId    String
  season           Season
  months           Int[]
  seasonNote       String?
  singleSupplement Decimal?                @db.Decimal(12, 2)
  tripleReduction  Decimal?                @db.Decimal(12, 2)
  isOnRequest      Boolean                 @default(false)
  notes            String?
  sortOrder        Int                     @default(0)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  priceBands       PrivateGroupPriceBand[]
  pricingPlan      PrivateGroupPricingPlan @relation(fields: [pricingPlanId], references: [id], onDelete: Cascade)

  @@index([pricingPlanId])
  @@index([season])
  @@index([sortOrder])
}

model PrivateGroupPriceBand {
  id              String             @id @default(cuid())
  seasonId        String
  minPayingPax    Int
  maxPayingPax    Int?
  doubleTwinPrice Decimal            @db.Decimal(12, 2)
  isActive        Boolean            @default(true)
  sortOrder       Int                @default(0)
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  season          PrivateGroupSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@index([seasonId])
  @@index([minPayingPax])
  @@index([isActive])
  @@index([sortOrder])
}

model DepartureDate {
  id                    String            @id @default(cuid())
  tourId                String
  date                  DateTime
  price                 Float
  status                DepartureStatus   @default(AVAILABLE)
  earlyDiscountPercent  Float?
  earlyDiscountDeadline DateTime?
  capacity              Int               @default(0)
  bookedSeats           Int               @default(0)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  season                Season            @map("seasonEnum")
  priceDouble           Float
  singleSupplement      Float?
  tripleReduction       Float?
  bankTransactions      BankTransaction[]
  bookings              Booking[]
  cashTransactions      CashTransaction[]
  tour                  Tour              @relation(fields: [tourId], references: [id], onDelete: Cascade)
  expenses              Expense[]
  financeDocuments      FinanceDocument[]
  massArrangements      MassArrangement[]
  quotes                Quote[]
  supplierPayables      SupplierPayable[]

  @@index([tourId])
  @@index([date])
  @@index([status])
  @@index([season])
}

model TourControl {
  id               String   @id @default(cuid())
  tourId           String   @unique
  hotelStatus      Boolean  @default(false)
  busStatus        Boolean  @default(false)
  guideStatus      Boolean  @default(false)
  restaurantStatus Boolean  @default(false)
  massStatus       Boolean  @default(false)
  ticketStatus     Boolean  @default(false)
  supplierPayments Boolean  @default(false)
  roomingList      Boolean  @default(false)
  flightList       Boolean  @default(false)
  travelDocuments  Boolean  @default(false)
  finalNotes       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tour             Tour     @relation(fields: [tourId], references: [id])
}

model Booking {
  id                            String                   @id @default(cuid())
  bookingReference              String                   @unique
  userId                        String
  tourId                        String
  departureDateId               String?
  status                        BookingStatus            @default(PENDING)
  paymentStatus                 PaymentStatus            @default(UNPAID)
  numberOfGuests                Int
  totalPrice                    Float
  grossAmount                   Float
  commissionRateSnapshot        Float?
  payoutPerPaxSnapshot          Float?
  commissionAmount              Float                    @default(0)
  netAmount                     Float
  currency                      String                   @default("EUR")
  agentNameSnapshot             String?
  agentEmailSnapshot            String?
  agentPhoneSnapshot            String?
  agencyNameSnapshot            String?
  partnerTypeSnapshot           PartnerType?
  membershipSnapshot            String?
  tourTitleSnapshot             String
  categorySnapshot              String
  subcategoriesSnapshot         String[]
  tagsSnapshot                  String[]
  destinationsSnapshot          String[]
  durationSnapshot              Int
  shortDescriptionSnapshot      String?
  overviewSnapshot              String?
  brochureUrlSnapshot           String?
  mainImageUrlSnapshot          String?
  mapImageUrlSnapshot           String?
  departureDateSnapshot         DateTime?
  pricePerPersonSnapshot        Float
  earlyDiscountPercentSnapshot  Float?
  earlyDiscountDeadlineSnapshot DateTime?
  customerName                  String?
  customerEmail                 String?
  customerPhone                 String?
  leadFirstName                 String?
  leadLastName                  String?
  leadEmail                     String?
  leadPhone                     String?
  adults                        Int                      @default(1)
  children                      Int                      @default(0)
  infants                       Int                      @default(0)
  singleRooms                   Int                      @default(0)
  doubleRooms                   Int                      @default(0)
  twinRooms                     Int                      @default(0)
  landOnly                      Boolean                  @default(true)
  needsFlights                  Boolean                  @default(false)
  notes                         String?
  specialRequests               String?
  internalNotes                 String?
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt
  bookingType                   BookingType              @default(FIT)
  depositDeadline               DateTime?
  estimatedPax                  Int?
  finalPax                      Int?
  groupLeaderName               String?
  groupName                     String?
  roomingListDeadline           DateTime?
  bookingDisplayCode            String?                  @unique
  bookingNumber                 Int                      @unique @default(autoincrement())
  seasonSnapshot                Season?                  @map("seasonSnapshotEnum")
  tripleRooms                   Int                      @default(0)
  amountDue                     Float                    @default(0)
  amountPaid                    Float                    @default(0)
  paymentDueDate                DateTime?
  payoutId                      String?
  quoteId                       String?                  @unique
  partnerCompanyId              String?
  partnerPackageName            String?
  partnerTourAliasId            String?
  complimentaryPaxSnapshot      Int?
  netRateDoubleTwinSnapshot     Float?
  netRateSingleSnapshot         Float?
  netRateTripleSnapshot         Float?
  payingPaxSnapshot             Int?
  quoteAcceptedAtSnapshot       DateTime?
  quoteCommercialSnapshot       Json?
  quoteReferenceSnapshot        String?
  quoteVersionSnapshot          Int?
  travelEndDateSnapshot         DateTime?
  travelStartDateSnapshot       DateTime?
  bankTransactions              BankTransaction[]
  departureDate                 DepartureDate?           @relation(fields: [departureDateId], references: [id])
  partnerCompany                PartnerCompany?          @relation(fields: [partnerCompanyId], references: [id])
  partnerTourAlias              PartnerTourAlias?        @relation(fields: [partnerTourAliasId], references: [id])
  payout                        PartnerPayout?           @relation(fields: [payoutId], references: [id])
  quote                         Quote?                   @relation(fields: [quoteId], references: [id])
  tour                          Tour                     @relation(fields: [tourId], references: [id])
  user                          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  operationControl              BookingOperationControl?
  paymentSchedules              BookingPaymentSchedule[]
  cashTransactions              CashTransaction[]
  expenses                      Expense[]
  financeDocuments              FinanceDocument[]
  financeEntries                FinanceEntry[]
  massArrangements              MassArrangement[]
  passengers                    Passenger[]
  payments                      Payment[]
  paymentSubmissions            PaymentSubmission[]
  refunds                       Refund[]
  roomAssignments               RoomAssignment[]
  salesDocuments                SalesDocument[]
  supplierPayables              SupplierPayable[]
  supportMessages               SupportMessage[]

  @@index([userId])
  @@index([tourId])
  @@index([departureDateId])
  @@index([payoutId])
  @@index([status])
  @@index([paymentStatus])
  @@index([bookingType])
  @@index([createdAt])
  @@index([groupName])
  @@index([partnerCompanyId])
  @@index([partnerTourAliasId])
  @@index([partnerPackageName])
}

model BookingOperationControl {
  id               String          @id @default(cuid())
  bookingId        String          @unique
  hotelStatus      Boolean         @default(false)
  busStatus        Boolean         @default(false)
  guideStatus      Boolean         @default(false)
  restaurantStatus Boolean         @default(false)
  massStatus       Boolean         @default(false)
  ticketStatus     Boolean         @default(false)
  supplierPayments Boolean         @default(false)
  roomingList      Boolean         @default(false)
  flightList       Boolean         @default(false)
  travelDocuments  Boolean         @default(false)
  status           OperationStatus @default(PENDING)
  finalNotes       String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  documentItems    Json?
  emergencyItems   Json?
  guideItems       Json?
  hotelItems       Json?
  massItems        Json?
  paymentItems     Json?
  restaurantItems  Json?
  ticketItems      Json?
  transportItems   Json?
  booking          Booking         @relation(fields: [bookingId], references: [id])
}

model CustomTourRequest {
  id                    String              @id @default(cuid())
  userId                String
  requestReference      String              @unique
  status                CustomRequestStatus @default(NEW)
  requestType           CustomRequestType   @default(TAILOR_MADE)
  title                 String?
  destination           String?
  destinations          String[]
  startDate             DateTime?
  endDate               DateTime?
  durationDays          Int?
  estimatedPax          Int?
  adults                Int?                @default(1)
  children              Int?                @default(0)
  budgetPerPerson       Float?
  currency              String              @default("EUR")
  accommodationLevel    String?
  roomPreference        String?
  needsFlights          Boolean             @default(false)
  landOnly              Boolean             @default(true)
  groupName             String?
  groupLeaderName       String?
  customerName          String?
  customerEmail         String?
  customerPhone         String?
  notes                 String?
  internalNotes         String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  bookingType           BookingType         @default(FIT)
  companyName           String?
  doubleRooms           Int?                @default(0)
  infants               Int?                @default(0)
  leadEmail             String?
  leadFirstName         String?
  leadLastName          String?
  leadPhone             String?
  requestName           String?
  singleRooms           Int?                @default(0)
  specialRequests       String?
  totalBudget           Float?
  tripleRooms           Int?                @default(0)
  twinRooms             Int?                @default(0)
  selectedQuoteId       String?
  adminReply            String?
  alternativeStartDate  DateTime?
  complimentaryPlaces   Int?                @default(0)
  dailyMassRequested    Boolean             @default(true)
  datesFlexible         Boolean             @default(false)
  extensionRequest      String?
  guideLanguage         String?
  priestTraveling       Boolean             @default(false)
  specialChurchRequests String?
  tourId                String?
  requestNotes          CustomRequestNote[]
  selectedQuote         Quote?              @relation("SelectedQuote", fields: [selectedQuoteId], references: [id])
  tour                  Tour?               @relation(fields: [tourId], references: [id])
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  quotes                Quote[]             @relation("RequestQuotes")

  @@index([userId])
  @@index([tourId])
  @@index([status])
  @@index([requestType])
  @@index([bookingType])
  @@index([createdAt])
  @@index([customerEmail])
  @@index([groupName])
  @@index([selectedQuoteId])
}

model Quote {
  id                        String              @id @default(cuid())
  requestId                 String?
  quoteNumber               Int                 @unique @default(autoincrement())
  quoteReference            String?             @unique
  version                   Int                 @default(1)
  status                    QuoteStatus         @default(DRAFT)
  currency                  String              @default("EUR")
  title                     String?
  clientMessage             String?
  internalNotes             String?
  termsAndNotes             String?
  validityNotes             String?
  subtotal                  Float               @default(0)
  discountTotal             Float               @default(0)
  taxTotal                  Float               @default(0)
  totalAmount               Float               @default(0)
  sentAt                    DateTime?
  convertedAt               DateTime?
  expiresAt                 DateTime?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  departureDateId           String?
  finalizedAt               DateTime?
  finalizedById             String?
  pdfGeneratedAt            DateTime?
  pdfUrl                    String?
  purpose                   QuotePurpose        @default(CUSTOM_REQUEST)
  recipientEmail            String?
  recipientName             String?
  recipientType             PartnerType?
  sentById                  String?
  tourId                    String?
  calculationVersion        String?
  quoteBuilderPayload       Json?
  quoteBuilderSummary       Json?
  templateId                String?
  viewedAt                  DateTime?
  approvedAt                DateTime?
  rejectedAt                DateTime?
  agentName                 String?
  clientName                String?
  destination               String?
  groupSize                 Int?
  travelDates               String?
  validUntil                DateTime?
  emailOpenCount            Int                 @default(0)
  pdfDownloadCount          Int                 @default(0)
  viewCount                 Int                 @default(0)
  cancellationPolicy        String?
  clientDocumentTitle       String?
  clientDoubleTwinPrice     Float?
  clientExcludes            String?
  clientIncludes            String?
  clientOfferNotes          String?
  clientPdfGeneratedAt      DateTime?
  clientPdfUrl              String?
  clientSinglePrice         Float?
  clientTriplePrice         Float?
  paymentPolicy             String?
  agentClientPdfUrl         String?
  agentClientPdfGeneratedAt DateTime?
  agentId                   String?
  partnerCompanyId          String?
  partnerPackageName        String?
  partnerTourAliasId        String?
  acceptedAt                DateTime?
  acceptedById              String?
  booking                   Booking?
  agent                     User?               @relation("QuoteAgent", fields: [agentId], references: [id], onDelete: SetNull)
  selectedFor               CustomTourRequest[] @relation("SelectedQuote")
  acceptedBy                User?               @relation("QuoteAcceptedBy", fields: [acceptedById], references: [id])
  departureDate             DepartureDate?      @relation(fields: [departureDateId], references: [id])
  finalizedBy               User?               @relation("QuoteFinalizedBy", fields: [finalizedById], references: [id])
  partnerCompany            PartnerCompany?     @relation(fields: [partnerCompanyId], references: [id])
  partnerTourAlias          PartnerTourAlias?   @relation(fields: [partnerTourAliasId], references: [id])
  request                   CustomTourRequest?  @relation("RequestQuotes", fields: [requestId], references: [id])
  sentBy                    User?               @relation("QuoteSentBy", fields: [sentById], references: [id])
  template                  QuoteTemplate?      @relation(fields: [templateId], references: [id])
  tour                      Tour?               @relation(fields: [tourId], references: [id])
  activities                QuoteActivity[]
  items                     QuoteItem[]

  @@index([agentId])
  @@index([requestId])
  @@index([tourId])
  @@index([departureDateId])
  @@index([templateId])
  @@index([status])
  @@index([purpose])
  @@index([createdAt])
  @@index([expiresAt])
  @@index([recipientEmail])
  @@index([calculationVersion])
  @@index([agentName])
  @@index([clientName])
  @@index([destination])
  @@index([validUntil])
  @@index([partnerCompanyId])
  @@index([partnerTourAliasId])
  @@index([partnerPackageName])
}

model QuoteItem {
  id             String        @id @default(cuid())
  quoteId        String
  itemType       QuoteItemType @default(SERVICE)
  title          String
  description    String?
  quantity       Float         @default(1)
  unitPrice      Float
  discountAmount Float         @default(0)
  taxRate        Float?
  taxAmount      Float         @default(0)
  total          Float
  currency       String        @default("EUR")
  optional       Boolean       @default(false)
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  meta           Json?
  quote          Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@index([itemType])
  @@index([sortOrder])
  @@index([optional])
}

model QuoteActivity {
  id         String              @id @default(cuid())
  quoteId    String
  actorId    String?
  action     QuoteActivityAction
  fromStatus QuoteStatus?
  toStatus   QuoteStatus?
  message    String?
  meta       Json?
  createdAt  DateTime            @default(now())
  actor      User?               @relation(fields: [actorId], references: [id])
  quote      Quote               @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model CustomRequestNote {
  id        String            @id @default(cuid())
  requestId String
  authorId  String
  content   String
  createdAt DateTime          @default(now())
  author    User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  request   CustomTourRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([authorId])
}

model Passenger {
  id                    String          @id @default(cuid())
  bookingId             String
  firstName             String
  lastName              String
  gender                String?
  dateOfBirth           DateTime?
  nationality           String?
  passportNumber        String?
  passportExpiry        DateTime?
  isLeadPassenger       Boolean         @default(false)
  specialRequests       String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  email                 String?
  emergencyContactName  String?
  emergencyContactPhone String?
  middleName            String?
  notes                 String?
  passportCountry       String?
  passportIssueDate     DateTime?
  phone                 String?
  title                 String?
  roomAssignmentId      String?
  roomType              RoomType?
  booking               Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomAssignment        RoomAssignment? @relation(fields: [roomAssignmentId], references: [id])

  @@index([bookingId])
  @@index([roomAssignmentId])
  @@index([isLeadPassenger])
}

model RoomAssignment {
  id         String               @id @default(cuid())
  bookingId  String
  roomCode   String?
  roomType   RoomType
  occupancy  Int                  @default(1)
  status     RoomAssignmentStatus @default(DRAFT)
  notes      String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  passengers Passenger[]
  booking    Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([roomType])
  @@index([status])
}

model Payment {
  id                   String              @id @default(cuid())
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  bookingId            String?
  tourId               String?
  agencyGroupName      String?
  amount               Float
  currency             String              @default("EUR")
  method               PaymentMethod
  status               PaymentRecordStatus @default(PENDING)
  reference            String?
  notes                String?
  paidAt               DateTime?
  receivedBy           String?
  allocationLockReason String?
  allocationLockedAt   DateTime?
  bankTransactions     BankTransaction[]
  financeDocument      FinanceDocument?
  booking              Booking?            @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  tour                 Tour?               @relation(fields: [tourId], references: [id])
  allocations          PaymentAllocation[]
  refunds              Refund[]
  salesDocuments       SalesDocument[]

  @@index([bookingId])
  @@index([tourId])
  @@index([agencyGroupName])
